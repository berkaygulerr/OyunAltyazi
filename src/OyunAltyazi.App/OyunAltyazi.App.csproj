<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OyunAltyazi.Core\OyunAltyazi.Core.csproj" />
    <ProjectReference Include="..\OyunAltyazi.Translation\OyunAltyazi.Translation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\ct2server\server.py" Link="server.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>OyunAltyazi.App.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>

</Project>
