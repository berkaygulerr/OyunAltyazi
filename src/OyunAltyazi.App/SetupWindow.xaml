<Window x:Class="OyunAltyazi.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OyunAltyazı — Kurulum" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="İlk kurulum" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="Yerel çeviri için gerekli bileşenler indiriliyor (yaklaşık 300–900 MB, bir kez). Bu sırada uygulamayı Google çeviri ile kullanabilirsiniz."/>

        <TextBlock x:Name="PyLabel" Text="Python çalışma ortamı" FontWeight="SemiBold"/>
        <ProgressBar x:Name="PyBar" Height="8" Maximum="1" Margin="0,4,0,2"/>
        <TextBlock x:Name="PyText" Style="{StaticResource Muted}" FontSize="11" Text="Bekliyor"/>

        <TextBlock Text="Çeviri paketleri (CTranslate2)" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <ProgressBar x:Name="PkgBar" Height="8" Maximum="1" Margin="0,4,0,2"/>
        <TextBlock x:Name="PkgText" Style="{StaticResource Muted}" FontSize="11" Text="Bekliyor"/>

        <TextBlock Text="Çeviri modeli" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <ProgressBar x:Name="ModelBar" Height="8" Maximum="1" Margin="0,4,0,2"/>
        <TextBlock x:Name="ModelText" Style="{StaticResource Muted}" FontSize="11" Text="Bekliyor"/>

        <TextBlock Text="Windows İngilizce OCR" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <TextBlock x:Name="OcrText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" Text="Denetleniyor…"/>
        <Button x:Name="OcrBtn" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,4"
                Content="Windows İngilizce OCR paketini kur (yönetici izni ister)" Click="OcrBtn_Click"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RetryBtn" Content="Yeniden dene" Padding="14,5" Visibility="Collapsed" Click="Retry_Click"/>
            <Button x:Name="CloseBtn" Content="Arka planda sürsün" Padding="14,5" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
