<Window x:Class="OyunAltyazi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OyunAltyazı" Width="1100" Height="720" MinWidth="960" MinHeight="640"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#566070"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hr" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sol sütun ===== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="OA" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OyunAltyazi" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Oyun altyazısı çevirmeni" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OYUN" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowCombo" SelectionChanged="WindowCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="RefreshBtn" Grid.Column="1" Content="⟳" Width="38" Height="38" Padding="0" FontSize="16" Margin="8,0,0,0"
                                    ToolTip="Pencere listesini yenile" Click="Refresh_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="StartBtn" Content="▶  Çeviriyi Başlat" Height="52" FontSize="15" Margin="0,12,0,12"
                        Style="{StaticResource SuccessButton}" Click="Start_Click"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DURUM" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Ellipse x:Name="DotCapture" Style="{StaticResource Dot}"/>
                            <TextBlock Text="Oyun yakalama" Style="{StaticResource StatusLabel}"/>
                            <TextBlock x:Name="CaptureStatus" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Ellipse x:Name="DotOcr" Style="{StaticResource Dot}"/>
                            <TextBlock Text="OCR" Style="{StaticResource StatusLabel}"/>
                            <TextBlock x:Name="OcrStatus" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotTr" Style="{StaticResource Dot}"/>
                            <TextBlock Text="Çevirmen" Style="{StaticResource StatusLabel}"/>
                            <TextBlock x:Name="TrStatus" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="WarningText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="CopyBtn" DockPanel.Dock="Right" Content="⧉ Kopyala" Padding="10,3" FontSize="11" IsEnabled="False" Click="Copy_Click"
                                    ToolTip="Son çeviriyi panoya kopyala"/>
                            <TextBlock Text="SON ALTYAZI" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="LastSpeakerText" Foreground="{StaticResource TealBrush}" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed" Margin="0,0,0,2"/>
                        <TextBlock x:Name="LastLineText" FontSize="17" TextWrapping="Wrap" Text="—"/>
                        <TextBlock x:Name="LastSourceText" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" Text="Henüz altyazı yok"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="GECİKME" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LatAvg" Text="—" Style="{StaticResource Metric}"/>
                                <TextBlock Text="ort. (sabit→ekran)" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LatP95" Text="—" Style="{StaticResource Metric}"/>
                                <TextBlock Text="p95" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LatencyText" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" Text="Henüz veri yok"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Sağ sütun ===== -->
        <TabControl x:Name="Tabs" Grid.Column="2" SelectionChanged="Tabs_SelectionChanged">

            <TabItem Header="Okuma Alanı">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,10">
                        <Button x:Name="SelectRegionBtn" DockPanel.Dock="Right" Content="▭  Bölgeyi çiz" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SelectRegion_Click"/>
                        <Button x:Name="PreviewRefreshBtn" DockPanel.Dock="Right" Content="⟳  Yenile" Click="PreviewRefresh_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Okuma alanı" Style="{StaticResource Heading}"/>
                            <TextBlock Text="OCR yalnızca mavi çerçevenin içini okur; altyazının geçtiği yeri kapsasın." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                        <Grid>
                            <Border Background="#0B0D11" CornerRadius="8" ClipToBounds="True">
                                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Visibility="Collapsed">
                                    <Grid x:Name="PreviewHost">
                                        <Image x:Name="PreviewImg"/>
                                        <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False">
                                            <Rectangle x:Name="RegionRect" Stroke="{StaticResource AccentBrush}" Fill="#333B82F6"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Önizleme için sol taraftan bir oyun penceresi seçin." Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
                        <DockPanel>
                            <TextBlock x:Name="RegionInfo" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Hızlı ayar:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="Alt orta" Tag="0.20,0.78,0.60,0.16" Click="Preset_Click" Margin="0,0,8,0"/>
                                <Button Content="Geniş alt bant" Tag="0.03,0.74,0.94,0.22" Click="Preset_Click" Margin="0,0,8,0"/>
                                <Button Content="Alt yarı" Tag="0,0.5,1,0.5" Click="Preset_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Altyazı Görünümü">
                <ScrollViewer>
                    <StackPanel Margin="0,0,10,0">
                        <Border Height="210" CornerRadius="12" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1B2A3A" Offset="0"/><GradientStop Color="#2B3B2E" Offset="0.55"/><GradientStop Color="#16191F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="ÖNİZLEME" Style="{StaticResource CardTitle}" Margin="14,12,0,0" Opacity="0.7"/>
                                <Border x:Name="BubblePreview" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,22" MaxWidth="560"
                                        CornerRadius="8" Padding="18,8" Background="#A6000000">
                                    <TextBlock x:Name="BubbleText" TextWrapping="Wrap" TextAlignment="Center" Foreground="White" FontFamily="Segoe UI" FontSize="19"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="FontValue" DockPanel.Dock="Right" FontWeight="SemiBold" Width="40" TextAlignment="Right"/>
                                    <TextBlock Text="Yazı boyutu" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="FontSlider" Minimum="20" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSlider_Changed" Margin="0,6,0,0"/>
                                <Border Style="{StaticResource Hr}"/>
                                <DockPanel>
                                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" FontWeight="SemiBold" Width="40" TextAlignment="Right"/>
                                    <TextBlock Text="Arka plan opaklığı" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_Changed" Margin="0,6,0,0"/>
                                <TextBlock Text="Örtme açıkken İngilizce yazı tamamen kapatıldığı için opaklık yalnızca örtme kapalıyken uygulanır." Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                <Border Style="{StaticResource Hr}"/>
                                <CheckBox x:Name="CoverCheck" IsChecked="True" Click="CoverCheck_Click">
                                    <StackPanel>
                                        <TextBlock Text="Üstüne yaz (İngilizceyi ört)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Türkçe kutu, özgün İngilizce altyazının üstüne oturur." Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Çeviri">
                <ScrollViewer>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Çevirmen" Style="{StaticResource Heading}" Margin="2,0,0,10"/>
                        <RadioButton x:Name="TrLocal" Style="{StaticResource RadioCard}" GroupName="tr" Checked="Translator_Checked">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="LocalBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="LocalBadgeText" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="Yerel model — CTranslate2 GPU" FontWeight="SemiBold" FontSize="14"/>
                                </DockPanel>
                                <TextBlock Text="Çevrimdışı, hızlı ve ücretsiz. İnternet gerekmez." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LocalHint" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"
                                           Text="Kurulum: tools\ct2server\setup.ps1 dosyasını çalıştırın (o zamana dek Google kullanılır)."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TrGoogle" Style="{StaticResource RadioCard}" GroupName="tr" Checked="Translator_Checked" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Google — çevrimiçi" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Kurulum gerektirmez; internet bağlantısı ister. Yerel model yoksa yedek olarak kullanılır." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock x:Name="TrLockedNote" Text="Çeviri çalışırken çevirmen değiştirilemez; önce durdurun." Style="{StaticResource Muted}" FontSize="11" Margin="2,8,0,0" Visibility="Collapsed"/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <DockPanel>
                                <Button x:Name="ClearCacheBtn" DockPanel.Dock="Right" Content="Önbelleği temizle" VerticalAlignment="Center" Click="ClearCache_Click"/>
                                <StackPanel>
                                    <TextBlock Text="ÇEVİRİ ÖNBELLEĞİ" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CacheCount" Text="0" Style="{StaticResource Metric}"/>
                                        <TextBlock Text="  kayıtlı satır" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="Daha önce çevrilen satırlar anında gösterilir." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sistem">
                <ScrollViewer>
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="KISAYOLLAR" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + T" FontFamily="Consolas" FontSize="12"/></Border>
                                    <TextBlock Grid.Column="1" Text="Çeviriyi başlat / durdur" VerticalAlignment="Top" Margin="0,4,0,10"/>
                                    <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + H" FontFamily="Consolas" FontSize="12"/></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Altyazıyı gizle / göster" VerticalAlignment="Top" Margin="0,4,0,10"/>
                                    <Border Grid.Row="2" Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="Ctrl + Shift + R" FontFamily="Consolas" FontSize="12"/></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Bölge seç" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="TANILAMA" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Klasörü aç" Click="OpenLogs_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <CheckBox x:Name="DiagCheck" Click="DiagCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="Tanılama günlüğü kaydet" FontWeight="SemiBold"/>
                                            <TextBlock Text="Her okuma %APPDATA%\OyunAltyazi\logs klasörüne yazılır; altyazı kaçarsa bu dosyayı gönderin." Style="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Border Style="{StaticResource Hr}"/>
                                <CheckBox x:Name="ScreenshotCheck" Click="ScreenshotCheck_Click">
                                    <StackPanel>
                                        <TextBlock Text="Ekran görüntüsünde göster (hata ayıklama)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Altyazı kutusu ekran görüntülerinde/yayınlarda da görünür. Kapalıyken OCR kendi çıktısını asla okumaz." Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="HAKKINDA" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="OyunAltyazi — Windows OCR ile oyun altyazısını okur, Türkçeye çevirip oyunun üstüne yazar." TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           Text="Yerel çeviri: Helsinki-NLP opus-mt-tc-big-en-tr (CC BY 4.0) + CTranslate2 (MIT). Arayüz tasarımı ve bazı bölümler GameTranslator (sefflex) / CouchSubs (Sinan Yorulmaz) projelerinden uyarlanmıştır (AGPL-3.0). Ayrıntılar için NOTICE.md dosyasına bakın."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
