<Window x:Class="OyunAltyazi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OyunAltyazı" Width="1240" Height="700" MinWidth="900" MinHeight="600"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#566070"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hr" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#29E3A73B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,8">
        <DockPanel>
            <Button x:Name="UpdateRestartBtn" DockPanel.Dock="Right" Content="Yeniden başlat" Padding="12,3" Click="UpdateRestart_Click"/>
            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" Text="Yeni sürüm hazır"/>
        </DockPanel>
    </Border>

    <!-- Komut çubuğu: kaynak seçimi + tek ana eylem -->
    <Border DockPanel.Dock="Top" Padding="24,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                <TextBlock Text="OyunAltyazı" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Oyun penceresi → Türkçe altyazı" Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
            <ComboBox x:Name="WindowCombo" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Stretch" SelectionChanged="WindowCombo_SelectionChanged"
                      AutomationProperties.Name="Oyun penceresi">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="RefreshBtn" Grid.Column="2" Content="Yenile" Height="38" Margin="8,0,0,0" Padding="14,0"
                    ToolTip="Pencere listesini yenile" AutomationProperties.Name="Pencere listesini yenile" Click="Refresh_Click"/>
            <Button x:Name="StartBtn" Grid.Column="3" Content="Çeviriyi başlat" Width="176" Height="38" FontSize="14" Margin="16,0,0,0"
                    Style="{StaticResource PrimaryButton}" ToolTip="Ctrl + Shift + T" Click="Start_Click"/>
        </Grid>
    </Border>

    <!-- Durum şeridi: yakalama / OCR / çevirmen + ölçülen gecikme -->
    <Border DockPanel.Dock="Bottom" Padding="24,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource CardBrush}">
        <StackPanel>
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse x:Name="DotCapture" Style="{StaticResource Dot}"/>
                    <TextBlock Text="Yakalama" Style="{StaticResource StatusLabel}"/>
                    <TextBlock x:Name="CaptureStatus" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse x:Name="DotOcr" Style="{StaticResource Dot}"/>
                    <TextBlock Text="OCR" Style="{StaticResource StatusLabel}"/>
                    <TextBlock x:Name="OcrStatus" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse x:Name="DotTr" Style="{StaticResource Dot}"/>
                    <TextBlock Text="Çevirmen" Style="{StaticResource StatusLabel}"/>
                    <TextBlock x:Name="TrStatus" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="LatencyPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Gecikme" Style="{StaticResource StatusLabel}"/>
                    <TextBlock x:Name="LatAvg" Text="—" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                    <TextBlock Text=" ort · p95 " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LatP95" Text="—" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock x:Name="LatencyText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="WarningText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" Margin="24,8,24,12" SelectionChanged="Tabs_SelectionChanged">

            <TabItem Header="Okuma Alanı">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <Border Background="#0B0C0E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="160">
                        <Grid>
                            <Viewbox x:Name="PreviewBox" Stretch="Uniform" Visibility="Collapsed">
                                <Grid x:Name="PreviewHost">
                                    <Image x:Name="PreviewImg"/>
                                    <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False">
                                        <Rectangle x:Name="RegionRect" Stroke="{StaticResource AccentBrush}" Fill="#33E3A73B"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Önizleme için yukarıdan bir oyun penceresi seçin." Style="{StaticResource Muted}" FontSize="14"
                                       Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Okuma alanı" Style="{StaticResource Heading}"/>
                            <TextBlock Text="OCR yalnızca amber çerçevenin içini okur; altyazının geçtiği yeri kapsasın." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="SelectRegionBtn" Content="Bölgeyi çiz" ToolTip="Ctrl + Shift + R" Click="SelectRegion_Click"/>
                                <Button x:Name="PreviewRefreshBtn" Grid.Column="2" Content="Önizlemeyi yenile" Click="PreviewRefresh_Click"/>
                            </Grid>
                            <TextBlock Text="HIZLI BÖLGE" Style="{StaticResource CardTitle}" Margin="0,16,0,6"/>
                            <WrapPanel>
                                <Button Content="Alt orta" Tag="0.20,0.78,0.60,0.16" Click="Preset_Click" Margin="0,0,6,6" Padding="10,4"/>
                                <Button Content="Geniş alt bant" Tag="0.03,0.74,0.94,0.22" Click="Preset_Click" Margin="0,0,6,6" Padding="10,4"/>
                                <Button Content="Alt yarı" Tag="0,0.5,1,0.5" Click="Preset_Click" Margin="0,0,6,6" Padding="10,4"/>
                            </WrapPanel>
                            <TextBlock x:Name="RegionInfo" Style="{StaticResource Muted}" FontSize="11" FontFamily="Cascadia Mono, Consolas"/>
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button x:Name="CopyBtn" DockPanel.Dock="Right" Content="Kopyala" Padding="10,2" FontSize="11" IsEnabled="False" Click="Copy_Click"
                                                ToolTip="Son çeviriyi panoya kopyala"/>
                                        <TextBlock Text="SON ALTYAZI" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LastSpeakerText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="LastLineText" FontSize="18" TextWrapping="Wrap" Text="—" MaxHeight="140" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LastSourceText" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" Text="Henüz altyazı yok"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Altyazı Görünümü">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0" MaxWidth="760" HorizontalAlignment="Center"
                                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Border Height="210" CornerRadius="12" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Background><SolidColorBrush Color="#1A1C20"/></Border.Background>
                            <Grid>
                                <TextBlock Text="ÖRNEK ALTYAZI" Style="{StaticResource CardTitle}" Margin="14,12,0,0" Opacity="0.7"/>
                                <Border x:Name="BubblePreview" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,22" MaxWidth="560"
                                        CornerRadius="8" Padding="18,8" Background="#A6000000">
                                    <TextBlock x:Name="BubbleText" TextWrapping="Wrap" TextAlignment="Center" Foreground="White" FontFamily="Segoe UI" FontSize="19"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Section}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="FontValue" DockPanel.Dock="Right" FontWeight="SemiBold" Width="40" TextAlignment="Right"/>
                                    <TextBlock Text="Yazı boyutu" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="FontSlider" Minimum="20" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSlider_Changed" Margin="0,6,0,0"/>
                                <Border Style="{StaticResource Hr}"/>
                                <DockPanel>
                                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" FontWeight="SemiBold" Width="40" TextAlignment="Right"/>
                                    <TextBlock Text="Arka plan opaklığı" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_Changed" Margin="0,6,0,0"/>
                                <TextBlock Text="Örtme açıkken İngilizce yazı tamamen kapatıldığı için opaklık yalnızca örtme kapalıyken uygulanır." Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                <Border Style="{StaticResource Hr}"/>
                                <CheckBox x:Name="CoverCheck" IsChecked="True" Click="CoverCheck_Click">
                                    <StackPanel>
                                        <TextBlock Text="Üstüne yaz (İngilizceyi ört)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Türkçe kutu, özgün İngilizce altyazının üstüne oturur." Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Çeviri">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0" MaxWidth="760" HorizontalAlignment="Center"
                                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <TextBlock Text="Çevirmen" Style="{StaticResource Heading}" Margin="2,0,0,10"/>
                        <RadioButton x:Name="TrLocal" Style="{StaticResource RadioCard}" GroupName="tr" Checked="Translator_Checked">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="LocalBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="LocalBadgeText" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="Yerel model — CTranslate2 GPU" FontWeight="SemiBold" FontSize="14"/>
                                </DockPanel>
                                <TextBlock Text="Çevrimdışı, hızlı ve ücretsiz. İnternet gerekmez." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LocalHint" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"
                                           Text="Kurulum: tools\ct2server\setup.ps1 dosyasını çalıştırın (o zamana dek Google kullanılır)."/>
                            </StackPanel>
                        </RadioButton>
                        <Border Style="{StaticResource Section}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="YEREL MODEL CİHAZI" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="LocalDeviceCombo" SelectionChanged="LocalDevice_Changed" HorizontalAlignment="Left" MinWidth="260">
                                    <ComboBoxItem Tag="gpu" Content="GPU (NVIDIA CUDA) — önerilen"/>
                                    <ComboBoxItem Tag="cpu" Content="CPU"/>
                                </ComboBox>
                                <TextBlock Text="GPU seçiliyken NVIDIA ekran kartı yoksa ya da başlatılamazsa otomatik olarak CPU kullanılır. Çeviri çalışırken değiştirilemez." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <RadioButton x:Name="TrGoogle" Style="{StaticResource RadioCard}" GroupName="tr" Checked="Translator_Checked" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Google — çevrimiçi" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Kurulum gerektirmez; internet bağlantısı ister. Yerel model yoksa yedek olarak kullanılır." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TrGemini" Style="{StaticResource RadioCard}" GroupName="tr" Checked="Translator_Checked" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Gemini Flash — çevrimiçi (isteğe bağlı)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Kendi API anahtarınızla daha doğal çeviri. Yerel çeviri her zaman yedektir; Gemini 2 sn içinde yanıt vermezse yerel çeviri gösterilir. Kapalıyken hiçbir veri gönderilmez." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <Border Style="{StaticResource Section}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="GEMINI API ANAHTARI" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="GeminiKeyBox" MaxLength="200" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="GeminiSaveBtn" Content="Anahtarı kaydet" Click="GeminiSave_Click"/>
                                    <Button x:Name="GeminiRemoveBtn" Content="Anahtarı sil" Margin="6,0,0,0" Click="GeminiRemove_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="GeminiStatus" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TrLockedNote" Text="Çeviri çalışırken çevirmen değiştirilemez; önce durdurun." Style="{StaticResource Muted}" FontSize="11" Margin="2,8,0,0" Visibility="Collapsed"/>

                        <Border Style="{StaticResource Section}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="OYUN PAKETİ VE SÖZLÜK (YEREL)" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LocalFilesInfo" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AutoPackStatus" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="AutoGlossaryStatus" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <CheckBox x:Name="AutoGlossaryCheck" Content="Bilinen oyunlar için yerleşik sözlüğü otomatik kullan (çevrimdışı, ağ yok)" Margin="0,6,0,0" Click="AutoGlossaryCheck_Click"/>
                                <CheckBox x:Name="AutoPackCheck" Content="Bilinen oyunlar için hazır paketi otomatik kullan (yalnızca paket dosyası indirilir)" Margin="0,6,0,0" Click="AutoPackCheck_Click"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="PackImportBtn" Content="Oyun paketi seç…" Click="PackImport_Click"/>
                                    <Button x:Name="PackRemoveBtn" Content="Kaldır" Margin="6,0,0,0" Click="PackRemove_Click"/>
                                    <Button x:Name="GlossaryImportBtn" Content="Sözlük seç…" Margin="16,0,0,0" Click="GlossaryImport_Click"/>
                                    <Button x:Name="GlossaryRemoveBtn" Content="Kaldır" Margin="6,0,0,0" Click="GlossaryRemove_Click"/>
                                </StackPanel>
                                <TextBlock Text="Dosya yalnızca seçili oyun için geçerlidir ve kendi bilgisayarınızda kalır. Tam eşleşen satırlar önbellekten ve modelden önce kullanılır; telif hakkıyla korunan diyalogları paylaşmayın." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0,18,0,0">
                            <DockPanel>
                                <Button x:Name="ClearCacheBtn" DockPanel.Dock="Right" Content="Önbelleği temizle" VerticalAlignment="Center" Click="ClearCache_Click"/>
                                <StackPanel>
                                    <TextBlock Text="ÇEVİRİ ÖNBELLEĞİ" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CacheCount" Text="0" Style="{StaticResource Metric}"/>
                                        <TextBlock Text="  kayıtlı satır" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="Daha önce çevrilen satırlar anında gösterilir." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sistem">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0" MaxWidth="760" HorizontalAlignment="Center"
                                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Border Style="{StaticResource Section}" Margin="0" BorderThickness="0" Padding="0">
                            <StackPanel>
                                <TextBlock Text="KISAYOLLAR" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + T" FontFamily="Cascadia Mono, Consolas" FontSize="12"/></Border>
                                    <TextBlock Grid.Column="1" Text="Çeviriyi başlat / durdur" VerticalAlignment="Top" Margin="0,4,0,10"/>
                                    <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + H" FontFamily="Cascadia Mono, Consolas" FontSize="12"/></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Altyazıyı gizle / göster" VerticalAlignment="Top" Margin="0,4,0,10"/>
                                    <Border Grid.Row="2" Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="Ctrl + Shift + R" FontFamily="Cascadia Mono, Consolas" FontSize="12"/></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Bölge seç" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="TANILAMA" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Klasörü aç" Click="OpenLogs_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <CheckBox x:Name="DiagCheck" Click="DiagCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="Tanılama günlüğü kaydet" FontWeight="SemiBold"/>
                                            <TextBlock Text="Her okuma %APPDATA%\OyunAltyazi\logs klasörüne yazılır; altyazı kaçarsa bu dosyayı gönderin." Style="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                                <Border Style="{StaticResource Hr}"/>
                                <CheckBox x:Name="ScreenshotCheck" Click="ScreenshotCheck_Click">
                                    <StackPanel>
                                        <TextBlock Text="Ekran görüntüsünde göster (hata ayıklama)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Altyazı kutusu ekran görüntülerinde/yayınlarda da görünür. Kapalıyken OCR kendi çıktısını asla okumaz." Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="SÜRÜM VE BİLEŞENLER" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="VersionText" Text="Sürüm: —" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" Text="Güncellemeler arka planda otomatik denetlenir."/>
                                <TextBlock x:Name="ComponentsText" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Bileşenleri onar" Padding="12,4" Click="Repair_Click"/>
                                    <Button Content="Güncellemeleri denetle" Padding="12,4" Margin="8,0,0,0" Click="CheckUpdate_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="HAKKINDA" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="OyunAltyazi — Windows OCR ile oyun altyazısını okur, Türkçeye çevirip oyunun üstüne yazar." TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           Text="Yerel çeviri: Helsinki-NLP opus-mt-tc-big-en-tr (CC BY 4.0) + CTranslate2 (MIT). Arayüz tasarımı ve bazı bölümler GameTranslator (sefflex) / CouchSubs (Sinan Yorulmaz) projelerinden uyarlanmıştır (AGPL-3.0). Ayrıntılar için NOTICE.md dosyasına bakın."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
    </TabControl>
    </DockPanel>
</Window>
