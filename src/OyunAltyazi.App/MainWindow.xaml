<Window x:Class="OyunAltyazi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OyunAltyazı" Width="720" Height="380" MinWidth="640" Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E6E6"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,5"/></Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="SelectRegionBtn" DockPanel.Dock="Right" Content="Bölge seç" Margin="8,0,0,0" Click="SelectRegion_Click"/>
            <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="⟳" ToolTip="Pencere listesini yenile" Margin="8,0,0,0" Click="Refresh_Click"/>
            <TextBlock Text="Oyun:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="WindowCombo" SelectionChanged="WindowCombo_SelectionChanged"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,12">
            <ComboBox x:Name="TranslatorCombo" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="TranslatorCombo_SelectionChanged">
                <ComboBoxItem Tag="auto" Content="Yerel (CTranslate2, GPU)"/>
                <ComboBoxItem Tag="google_only" Content="Google"/>
            </ComboBox>
            <Button x:Name="StartBtn" Content="▶ Başlat" HorizontalAlignment="Left" Click="Start_Click"/>
        </DockPanel>
        <CheckBox x:Name="CoverCheck" Content="Üstüne yaz (İngilizceyi ört)" Foreground="#E6E6E6" IsChecked="True" Margin="0,0,0,8" Click="CoverCheck_Click"/>
        <DockPanel Margin="0,0,0,8">
            <TextBlock x:Name="FontValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Yazı boyutu:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider x:Name="FontSlider" Minimum="20" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSlider_Changed"/>
        </DockPanel>
        <CheckBox x:Name="ScreenshotCheck" Content="Ekran görüntüsünde göster (hata ayıklama)" Foreground="#E6E6E6" Margin="0,0,0,8" Click="ScreenshotCheck_Click"/>
        <TextBlock x:Name="WarningText" Foreground="#F6AD55" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Foreground="#A0AEC0" Margin="0,0,0,8"/>
        <TextBlock x:Name="LastLineText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12" Text="Son satır: —"/>
        <TextBlock x:Name="LatencyText" Foreground="#A0AEC0" TextWrapping="Wrap"/>
        <TextBlock Foreground="#718096" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Kısayollar: Ctrl+Shift+T başlat/durdur · Ctrl+Shift+H altyazıyı gizle/göster · Ctrl+Shift+R bölge seç"/>
    </StackPanel>
</Window>
