<Window x:Class="OyunAltyazi.App.ReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Paket atölyesi · OyunAltyazı"
        Style="{StaticResource AppWindow}" Width="900" Height="600" MinWidth="700" MinHeight="515"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="GameLabel" Style="{StaticResource CardTitle}" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Paket atölyesi" Style="{StaticResource Heading}" FontSize="26" Margin="0,4,0,4"/>
            <TextBlock Text="Geçmişteki çevirileri düzelt. Yalnızca onayladığın satırlar pakete girer." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="CountLabel" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ApprovedOnly" Grid.Row="1" Content="Yalnızca onaylı satırlar" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,0,0,10"/>
                    <ListBox x:Name="Rows" Grid.Row="2" SelectionChanged="RowChanged" AutomationProperties.Name="Replik geçmişi"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,5"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Cell" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="{StaticResource Card2Brush}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="{StaticResource AccentTintBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Original}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock Text="{Binding State}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyLabel" Grid.Row="2" Style="{StaticResource Muted}" Margin="4,10" TextWrapping="Wrap" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid x:Name="Editor">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="İNGİLİZCE KAYNAK" Margin="0,0,0,6"/>
                    <TextBox x:Name="SourceBox" Grid.Row="1" AutomationProperties.Name="İngilizce kaynak" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource CardTitle}" Text="TÜRKÇE ÇEVİRİ" Margin="0,13,0,6"/>
                    <TextBox x:Name="TurkishBox" Grid.Row="3" AutomationProperties.Name="Türkçe çeviri" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000"/>
                    <DockPanel Grid.Row="4" Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Onayla ve kaydet" Click="ApproveClick"/>
                        <Button x:Name="UndoApproval" HorizontalAlignment="Left" Content="Onayı kaldır" Click="UndoClick"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ExportButton" Content="JSON paketi çıkar…" Click="ExportClick" Margin="0,0,8,0"/>
                <Button Content="Kapat" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="StatusLabel" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>
    </Grid>
</Window>