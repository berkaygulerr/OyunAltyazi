<Window x:Class="OyunAltyazi.App.UI.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altyazı bölgesini seç" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" ResizeMode="NoResize">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Foreground="#BBB" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Fareyle altyazının geçtiği dikdörtgeni çizin."/>
            <Button x:Name="SaveBtn" Content="Kaydet" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="İptal" Padding="16,4" IsCancel="True"/>
        </StackPanel>
        <Canvas x:Name="Surface" Background="Black" MouseLeftButtonDown="Down" MouseMove="Move" MouseLeftButtonUp="Up">
            <Image x:Name="Img"/>
            <Rectangle x:Name="Sel" Stroke="#4FD1C5" StrokeThickness="2" Fill="#334FD1C5"/>
        </Canvas>
    </DockPanel>
</Window>
