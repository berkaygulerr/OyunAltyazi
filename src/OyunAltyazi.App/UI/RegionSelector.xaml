<Window x:Class="OyunAltyazi.App.UI.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altyazı bölgesini seç" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="İptal" Padding="20,8" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SaveBtn" Content="Kaydet" Padding="22,8" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Fareyle altyazının geçtiği dikdörtgeni çizin."/>
        </DockPanel>
        <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
            <Canvas x:Name="Surface" Background="Black" Cursor="Cross" MouseLeftButtonDown="Down" MouseMove="Move" MouseLeftButtonUp="Up">
                <Image x:Name="Img"/>
                <Rectangle x:Name="Sel" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="#33E3A73B"/>
            </Canvas>
        </Border>
    </DockPanel>
</Window>
