<Window x:Class="OyunAltyazi.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OyunAltyazı Altyazı" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="400" Height="200">
    <Grid>
        <Border x:Name="Box" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                CornerRadius="8" Padding="18,8" Background="#A6000000">
            <TextBlock x:Name="Text" Foreground="White" FontFamily="Segoe UI" FontSize="30"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <Canvas x:Name="CoverLayer">
            <Border x:Name="CoverBox" Visibility="Collapsed" CornerRadius="8" Padding="12,6" Background="#EB121212">
                <TextBlock x:Name="CoverText" Foreground="White" FontFamily="Segoe UI" TextWrapping="Wrap" TextAlignment="Center" LineStackingStrategy="BlockLineHeight">
                    <TextBlock.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
            </Border>
        </Canvas>
    </Grid>
</Window>
